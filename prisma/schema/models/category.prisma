model Category {
    id       String     @id @default(uuid())
    parentId String?
    parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
    children Category[] @relation("CategoryTree")

    name         String
    slug         String       @unique
    imageUrl     String?
    description  String?
    isActive     Boolean      @default(true)
    displayOrder Int          @default(0)
    attributes CategoryAttribute[]
    products   Product[]
    sizeCharts SizeChart[]
    genderImages CategoryImage[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([parentId])
}

model CategoryAttribute {
    id         String   @id @default(uuid())
    categoryId String
    category   Category @relation(fields: [categoryId], references: [id])

    key          String
    label        String
    type         String
    options      Json?
    isFilterable Boolean @default(false)

    createdAt DateTime @default(now())

    @@unique([categoryId, key])
}

// Controls whether a category appears in a given gender tab of the mobile
// catalog, and in what order. A row is an explicit opt-in: no row (or
// isActive false) means the category is hidden from that tab, regardless of
// what products it holds. imageUrl is optional — an enabled placement with no
// image falls back to Category.imageUrl.
model CategoryImage {
    id         String   @id @default(uuid())
    categoryId String
    category   Category @relation(fields: [categoryId], references: [id])
    gender     GenderType
    imageUrl   String?

    isActive     Boolean @default(true)
    displayOrder Int     @default(0)

    @@unique([categoryId, gender])
    @@index([gender, isActive, displayOrder])
}
