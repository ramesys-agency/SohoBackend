model PickupAddress {
    id        String   @id @default(uuid())
    name      String
    address   String
    division  String
    district  String
    thana     String
    phone     String
    latitude  Float?
    longitude Float?

    // External Logistics IDs & Fields
    senderFullName    String?
    senderAddress     String?
    senderUnitOrFloor String?
    senderPhoneNumber String?
    pickupNote        String?
    senderThanaId     String?
    senderRdxId       String?
    pathaoCityId      String?
    pathaoZoneId      String?
    pathaoStoreId     String?
    redxStoreId       String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

