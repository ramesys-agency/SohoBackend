model Order {
    id          String      @id @default(uuid())
    userId      String
    addressId   String
    status      OrderStatus @default(pending)
    totalAmount Decimal

    couponId       String?
    discountAmount Decimal @default(0)

    /// Delivery charge applied at checkout, kept as its own line so the total
    /// can be audited and so a later change to the fee never rewrites history.
    /// totalAmount = sum(items) + shippingFee - discountAmount.
    shippingFee Decimal @default(0)

    user    User    @relation(fields: [userId], references: [id])
    address Address @relation(fields: [addressId], references: [id])
    coupon  Coupon? @relation(fields: [couponId], references: [id])

    items        OrderItem[]
    payments     Payment[]
    statusLogs   OrderStatusLog[]
    reservations StockReservation[]
    logisticsJob LogisticsJob?

    // Manual shipping fallback. `standard` orders are handed to RoadRush by the
    // retry queue; `manual_shipping` means every attempt failed and staff have
    // to arrange the delivery themselves.
    orderType       OrderType @default(standard)
    manualReason    String?
    manualFlaggedAt DateTime?
    manualHandledAt DateTime?
    /// Admin user id that took ownership of the manual delivery.
    manualHandledBy String?

    // Logistics specific fields
    aggregator              String?
    merchantPickupAddressId String?
    receiverDivision        String?
    receiverDistrict        String?
    receiverThana           String?
    dropAddress             String?
    customerMobileNumber    String?
    customerFullName        String?
    customerEmail           String?
    itemValue               Decimal?
    cod                     Boolean  @default(false)
    itemDetails             String?
    orderCode               String?
    lastLogisticsSync       DateTime?

    // Raw partner status name (e.g. "Rider Accepted"), kept alongside the
    // collapsed `status` enum so tracking shows what RoadRush actually reported.
    logisticsStatusName String?

    // Detailed Logistics & COD Fields
    cashCollectAmount   Decimal? @default(0)
    deliveryFee         Decimal? @default(0)
    codCharge           Decimal? @default(0)
    vat                 Decimal? @default(0)
    tax                 Decimal? @default(0)
    deliveryPriority    String?  @default("now")
    otp                 String?
    rcvPay              Boolean? @default(true)
    requestDeliveryDate String?
    distanceKm          Decimal? @default(0)


    createdAt DateTime @default(now())

    // Drives the "needs manual shipping" list in the admin dashboard.
    @@index([orderType, manualHandledAt])
}

model OrderItem {
    id         String  @id @default(uuid())
    orderId    String
    productId  String
    variantId  String
    quantity   Int
    priceAtBuy Decimal

    order   Order          @relation(fields: [orderId], references: [id])
    product Product        @relation(fields: [productId], references: [id])
    variant ProductVariant @relation(fields: [variantId], references: [id])

    returns Return[]
}

model OrderStatusLog {
    id      String      @id @default(uuid())
    orderId String
    status  OrderStatus
    note    String?

    // Set only for entries mirrored from RoadRush `status_details`. Null means
    // the entry was written by an admin action.
    logisticsStatusName String?

    // Operational entries staff need but customers must never read — e.g. why
    // the courier hand-off failed. Filtered out of the customer timeline.
    internal Boolean @default(false)

    order     Order    @relation(fields: [orderId], references: [id])
    createdAt DateTime @default(now())

    @@index([orderId, logisticsStatusName])
}

model Return {
    id          String       @id @default(uuid())
    orderItemId String
    reason      String
    status      ReturnStatus @default(requested)

    // Returns are raised by an admin after the customer reaches out (WhatsApp,
    // phone, email), so a partial quantity is common — a customer keeps two of
    // three shirts and sends one back.
    quantity Int @default(1)

    // Internal admin note, e.g. "Customer sent photos on WhatsApp, sleeve torn".
    // Surfaced to the customer in the app alongside the return.
    note String?

    // Set when the return is refunded. Kept on the return (not just the payment)
    // so partial refunds across several returns on one order stay attributable.
    refundAmount Decimal?

    orderItem OrderItem @relation(fields: [orderItemId], references: [id])
    createdAt DateTime  @default(now())
    // Defaulted as well as @updatedAt so `db push` can backfill any existing row.
    updatedAt DateTime  @default(now()) @updatedAt

    @@index([orderItemId])
    @@index([status])
}
