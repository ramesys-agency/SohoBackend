model Order {
    id        String @id @default(uuid())
    userId    String
    addressId String

    /// The effective status — the one the customer, the app and every list in
    /// the dashboard read. It is DERIVED, never written by hand: both writers
    /// state their own opinion below and `resolveOrderStatus` decides which one
    /// wins. See order-status.resolver.ts.
    status OrderStatus @default(pending)

    /// Which opinion the resolver sided with for the current `status`.
    statusSource StatusSource @default(system)

    /// True when the two opinions disagree in a way the resolver would not
    /// settle on its own — an admin cancelled an order RoadRush is still
    /// delivering, RoadRush cancelled one we think is fine, or a pinned status
    /// has been overtaken. Drives the reconciliation queue.
    statusConflict       Boolean @default(false)
    statusConflictReason String?

    /// Set when an admin has looked at the conflict and chosen a side. Cleared
    /// automatically the moment RoadRush reports something new, so an
    /// acknowledged conflict cannot hide a later, different one.
    statusConflictAckAt DateTime?

    totalAmount Decimal

    couponId       String?
    discountAmount Decimal @default(0)

    /// Delivery charge applied at checkout, kept as its own line so the total
    /// can be audited and so a later change to the fee never rewrites history.
    /// totalAmount = sum(items) + shippingFee - discountAmount.
    shippingFee Decimal @default(0)

    user    User    @relation(fields: [userId], references: [id])
    address Address @relation(fields: [addressId], references: [id])
    coupon  Coupon? @relation(fields: [couponId], references: [id])

    items        OrderItem[]
    payments     Payment[]
    statusLogs   OrderStatusLog[]
    reservations StockReservation[]
    logisticsJob LogisticsJob?

    // --- The admin's opinion. Only updateOrderStatus writes these. ------------

    /// The last status a human asked for. Null until someone touches the order.
    adminStatus       OrderStatus?
    adminStatusAt     DateTime?
    /// Admin user id that made the call.
    adminStatusBy     String?
    adminStatusReason String?

    /// Set when an admin used the status override, or chose "Keep mine" on a
    /// conflict. While pinned, RoadRush can still report — and still raise a
    /// conflict — but it can no longer move the effective status.
    adminStatusPinned Boolean @default(false)

    // Manual shipping fallback. `standard` orders are handed to RoadRush by the
    // retry queue; `manual_shipping` means every attempt failed and staff have
    // to arrange the delivery themselves.
    orderType       OrderType @default(standard)
    manualReason    String?
    manualFlaggedAt DateTime?
    manualHandledAt DateTime?
    /// Admin user id that took ownership of the manual delivery.
    manualHandledBy String?

    // Logistics specific fields
    aggregator              String?
    merchantPickupAddressId String?
    receiverDivision        String?
    receiverDistrict        String?
    receiverThana           String?
    dropAddress             String?
    customerMobileNumber    String?
    customerFullName        String?
    customerEmail           String?
    itemValue               Decimal?
    cod                     Boolean  @default(false)
    itemDetails             String?
    orderCode               String?
    lastLogisticsSync       DateTime?

    // --- RoadRush's opinion. Only refreshOrderStatus writes these. -----------

    /// RoadRush's status collapsed onto our enum. Null until the first sync.
    logisticsStatus OrderStatus?

    // Raw partner status name (e.g. "Rider Accepted"), kept alongside the
    // collapsed `status` enum so tracking shows what RoadRush actually reported.
    logisticsStatusName String?

    // Detailed Logistics & COD Fields
    cashCollectAmount   Decimal? @default(0)
    deliveryFee         Decimal? @default(0)
    codCharge           Decimal? @default(0)
    vat                 Decimal? @default(0)
    tax                 Decimal? @default(0)
    deliveryPriority    String?  @default("now")
    otp                 String?
    rcvPay              Boolean? @default(true)
    requestDeliveryDate String?
    distanceKm          Decimal? @default(0)


    createdAt DateTime @default(now())

    // Drives the "needs manual shipping" list in the admin dashboard.
    @@index([orderType, manualHandledAt])
    // ...and the same for the "status needs reconciling" list.
    @@index([statusConflict, statusConflictAckAt])
}

model OrderItem {
    id         String  @id @default(uuid())
    orderId    String
    productId  String
    variantId  String
    quantity   Int
    priceAtBuy Decimal

    order   Order          @relation(fields: [orderId], references: [id])
    product Product        @relation(fields: [productId], references: [id])
    variant ProductVariant @relation(fields: [variantId], references: [id])

    returns Return[]
}

model OrderStatusLog {
    id      String      @id @default(uuid())
    orderId String
    status  OrderStatus
    note    String?

    // Set only for entries mirrored from RoadRush `status_details`. Null means
    // the entry was written by an admin action.
    logisticsStatusName String?

    /// Who caused this entry. Makes the timeline auditable after the fact —
    /// "who moved this to cancelled" was previously unanswerable.
    source StatusSource @default(system)

    // Operational entries staff need but customers must never read — e.g. why
    // the courier hand-off failed. Filtered out of the customer timeline.
    internal Boolean @default(false)

    order     Order    @relation(fields: [orderId], references: [id])
    createdAt DateTime @default(now())

    @@index([orderId, logisticsStatusName])
}

model Return {
    id          String       @id @default(uuid())
    orderItemId String
    reason      String
    status      ReturnStatus @default(requested)

    // Returns are raised by an admin after the customer reaches out (WhatsApp,
    // phone, email), so a partial quantity is common — a customer keeps two of
    // three shirts and sends one back.
    quantity Int @default(1)

    // Internal admin note, e.g. "Customer sent photos on WhatsApp, sleeve torn".
    // Surfaced to the customer in the app alongside the return.
    note String?

    // Set when the return is refunded. Kept on the return (not just the payment)
    // so partial refunds across several returns on one order stay attributable.
    refundAmount Decimal?

    orderItem OrderItem @relation(fields: [orderItemId], references: [id])
    createdAt DateTime  @default(now())
    // Defaulted as well as @updatedAt so `db push` can backfill any existing row.
    updatedAt DateTime  @default(now()) @updatedAt

    @@index([orderItemId])
    @@index([status])
}
