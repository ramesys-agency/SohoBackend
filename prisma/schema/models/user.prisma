model User {
    id           String   @id @default(uuid())
    email        String   @unique
    fullName     String
    phone        String?
    passwordHash   String?
    authProvider   String   @default("local") // local, google
    authProviderId String?  @unique
    role           UserRole @default(customer)
    avatar         String?
    age            Int?
    gender         String?
    region         String?
    isVerified     Boolean  @default(false)
    isDeleted      Boolean  @default(false)

    addresses           Address[]
    orders              Order[]
    reviews             Review[]
    wishlists           Wishlist[]
    cartItems           CartItem[]
    savedPaymentMethods SavedPaymentMethod[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model Address {
    id     String @id @default(uuid())
    userId String
    user   User   @relation(fields: [userId], references: [id])

    type        String
    dropAddress String?
    street      String
    city        String?
    state       String?
    division    String?
    district    String?
    thana       String?
    area        String?
    postalCode  String
    country     String?

    latitude  Float?
    longitude Float?

    placeId          String? // Google Place ID
    formattedAddress String?

    isDefault Boolean @default(false)
    isDeleted Boolean @default(false)

    orders Order[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}

model SavedPaymentMethod {
    id                String @id @default(uuid())
    userId            String
    provider          String // stripe, razorpay
    providerPaymentId String // e.g. pm_12345

    brand    String // Visa, MasterCard
    last4    String // 4242
    expMonth Int
    expYear  Int

    isDefault Boolean @default(false)
    isDeleted Boolean @default(false)

    user User @relation(fields: [userId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}
