/// A collection is created 1:1 with the placement that owns it — the admin
/// never makes one on its own. name/slug live here so the placement's identity
/// is a real, linkable handle, and coupons keep targeting collections.
model Collection {
    id       String  @id @default(uuid())
    name     String
    slug     String  @unique
    isActive Boolean @default(true)

    gender   GenderType[]
    products ProductCollection[]

    createdAt DateTime             @default(now())
    placement CollectionPlacement?
    coupons   CouponCollection[]
}


model ProductCollection {
    productId    String
    collectionId String
    displayOrder Int    @default(0)

    product    Product    @relation(fields: [productId], references: [id])
    collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@id([productId, collectionId])
}

/// One row per page+section slot on the storefront. Two placements built from
/// the same source still get their own name, image, product list and slug —
/// "Best Sellers" on MEN and on WOMEN are separate, independently editable rows.
model CollectionPlacement {
    id String @id @default(uuid())

    /// Unique: a collection belongs to exactly one placement.
    collectionId String     @unique
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

    description String?

    /// When set, tapping the placement deep-links to this product instead of
    /// opening its product list. Replaces HomePromo's PRODUCT content type.
    productId String?
    product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

    isBanner Boolean @default(false)
    imageUrl String?

    /// When set, this placement's product list is *derived* from the category
    /// (and everything beneath it) rather than hand-picked. Rows in
    /// CollectionPlacementProduct then act as overrides on top of that live
    /// list instead of being the list itself. Drives the catalog circle row.
    sourceCategoryId String?
    sourceCategory   Category? @relation("CategoryPlacements", fields: [sourceCategoryId], references: [id], onDelete: Cascade)

    page    PageType
    section SectionType

    displayOrder Int     @default(0)
    isActive     Boolean @default(true)

    createdAt DateTime @default(now())

    products CollectionPlacementProduct[]

    @@index([page, section, displayOrder])
    @@index([sourceCategoryId])
}

/// What a row means depends on whether its placement is category-sourced.
/// Hand-picked placements only ever use INCLUDE — the rows *are* the list.
enum PlacementProductMode {
    /// Force this product in, even if the source category does not hold it.
    /// Survives the product being recategorised.
    INCLUDE
    /// Drop this product from the derived list.
    EXCLUDE
    /// Position only. The product still has to be in the source category to
    /// show, so it disappears when it leaves — it just has a manual slot
    /// while it is there.
    ORDER
}

model CollectionPlacementProduct {
    placementId  String
    productId    String
    displayOrder Int                  @default(0)
    mode         PlacementProductMode @default(INCLUDE)

    placement CollectionPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
    product   Product             @relation(fields: [productId], references: [id])

    createdAt DateTime @default(now())

    @@id([placementId, productId])
}
