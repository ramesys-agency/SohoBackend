enum PageType {
    HOME
    MEN
    WOMEN
    KIDS
    OFFERS
}

/// Section decides how the placement renders on the storefront, so every
/// placement must declare one. See SECTION_GUIDANCE_MAP in the admin dashboard
/// for the layout each value maps to.
enum SectionType {
    HERO
    FEATURED_ROW
    GRID_SECTION
    MID_BANNER
    SEE_ALL
    /// The round category shortcuts along the top of a catalog tab. Always
    /// category-sourced, so its products come from the category itself.
    CATEGORY_CIRCLE
}
