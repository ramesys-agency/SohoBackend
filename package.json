{
    "name": "soho-backend",
    "type": "module",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "tsx src/server.ts",
        "start:dev": "tsx watch src/server.ts",
        "dev": "tsc --watch",
        "build": "tsc",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "prepare": "husky",
        "db:validate": "prisma validate --config prisma/prisma.config.ts",
        "db:generate": "prisma generate --config prisma/prisma.config.ts",
        "db:push": "prisma db push --config prisma/prisma.config.ts",
        "db:reset": "prisma migrate reset --config prisma/prisma.config.ts",
        "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
        "db:migrate:prod": "prisma migrate deploy --config prisma/prisma.config.ts",
        "db:studio": "prisma studio --config prisma/prisma.config.ts",
        "db:seed": "prisma db seed --config prisma/prisma.config.ts",
        "docker:dev": "docker compose -f docker-compose.dev.yml --profile all up -d",
        "docker:dev:down": "docker compose -f docker-compose.dev.yml --profile all down",
        "docker:build": "docker compose build",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1024.0",
        "@aws-sdk/s3-request-presigner": "^3.1024.0",
        "@prisma/adapter-pg": "^7.3.0",
        "@prisma/client": "^7.3.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "pg": "^8.17.2",
        "tslib": "^2.8.1",
        "winston": "^3.19.0",
        "winston-loki": "^6.1.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@eslint/js": "^9.39.2",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.16.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.2.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "prisma": "^7.3.0",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,json}": [
            "prettier --write"
        ]
    }
}
