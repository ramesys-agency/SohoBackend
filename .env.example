# Server Configuration
PORT=3000
NODE_ENV=development
APP_NAME=soho-backend

# Database Configuration
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/soho_db?schema=public

# Docker Compose (required for docker-compose up)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=soho_db


# Logging Configuration
LOG_LEVEL=http


# Security Configuration
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth Configuration
JWT_SECRET=your_jwt_secret_min_32_characters_long
AUTH_CACHE_TTL=300
AUTH_COOKIE_NAME=auth_token
GOOGLE_CLIENT_ID=your_google_web_client_id
APPLE_CLIENT_ID=com.yourcompany.app

# Redis Configuration
REDIS_ENABLED=false
# REDIS_URL=redis://user:password@localhost:6379/0  # URL takes precedence over host/port
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=soho-backend

# Storage Configuration (S3 or MinIO)
STORAGE=minio
BUCKET_NAME=soho-bucket
ACCESS_KEY=minioadmin
SECRET_KEY=minioadmin
AWS_REGION=us-east-1
ENDPOINT=http://localhost:9000

# Logistics Configuration (RoadRush)
ROADRUSH_BASE_URL=https://www.roadrush.xyz/api/customer
ROADRUSH_USERNAME=your_roadrush_username
ROADRUSH_PASSWORD=your_roadrush_password
# Merchant pickup (sender) address id on RoadRush.
# Leave blank to auto-resolve from the account's sender-address list.
ROADRUSH_PICKUP_ADDRESS_ID=

# Order status polling (RoadRush has no webhook)
# Set ORDER_STATUS_POLL_ENABLED=false if an external cron drives
# POST /api/v1/orders/admin/poll-statuses instead.
ORDER_STATUS_POLL_ENABLED=true
ORDER_STATUS_POLL_INTERVAL_MINUTES=15
ORDER_STATUS_POLL_BATCH_SIZE=50

# Logistics retry queue
# Delays apply after the immediate attempt: "5,30,120" = 1 try + 3 retries
# at +5m, +30m and +2h. When all of them fail the order is flagged for
# manual shipping. Set LOGISTICS_JOB_ENABLED=false if an external cron drives
# POST /api/v1/orders/admin/run-logistics-jobs instead.
LOGISTICS_JOB_ENABLED=true
LOGISTICS_JOB_POLL_INTERVAL_SECONDS=60
LOGISTICS_JOB_BATCH_SIZE=20
LOGISTICS_RETRY_DELAYS_MINUTES=5,30,120
LOGISTICS_JOB_STALE_CLAIM_MINUTES=10

# Checkout stock reservation (the 5-minute hold taken when checkout opens)
CHECKOUT_RESERVATION_ENABLED=true
CHECKOUT_RESERVATION_TTL_MINUTES=5
CHECKOUT_MAX_HOLD_MINUTES=20
RESERVATION_SWEEP_INTERVAL_SECONDS=60

# Who gets emailed when an order falls back to manual shipping (comma separated)
ADMIN_ALERT_EMAILS=

# License
LICENSE_KEY=SOHO-PRO-2024-XXXX
LICENSE_SERVICE_URL=http://localhost:5000

# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Soho Support <noreply@soho.com>"

# OAuth
GOOGLE_CLIENT_ID=[OAUTH_CLIENT_ID]
GOOGLE_CLIENT_SECRET=[OAUTH_CLIENT_SECRET]