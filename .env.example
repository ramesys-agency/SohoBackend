# Server Configuration
PORT=3000
NODE_ENV=development
APP_NAME=soho-backend

# Database Configuration
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/soho_db?schema=public

# Docker Compose (required for docker-compose up)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=soho_db

# Grafana (required for docker-compose up)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# Logging Configuration
LOG_LEVEL=info
LOKI_URL=http://localhost:3100
LOKI_ENABLED=true

# Security Configuration
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth Configuration
JWT_SECRET=your_jwt_secret_min_32_characters_long
AUTH_CACHE_TTL=300
AUTH_COOKIE_NAME=auth_token

# Redis Configuration
REDIS_ENABLED=false
# REDIS_URL=redis://user:password@localhost:6379/0  # URL takes precedence over host/port
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=soho-backend
